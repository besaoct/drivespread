{
  "name": "drivespread",
  "version": "1.0.7",
  "description": "Zero-infrastructure database using Google Sheets and Google Drive as a backend",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "require": "./dist/client.js",
      "import": "./dist/client.mjs"
    }
  },
  "bin": {
    "drivespread": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly && chmod +x dist/cli/index.js",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "google-sheets",
    "google-drive",
    "database",
    "zero-infra",
    "orm"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "latest",
    "cors": "latest",
    "express": "latest",
    "express-rate-limit": "latest",
    "googleapis": "latest",
    "jsonwebtoken": "latest",
    "uuid": "latest",
    "ws": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/bcryptjs": "latest",
    "@types/cors": "latest",
    "@types/express": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/node": "latest",
    "@types/uuid": "latest",
    "@types/ws": "latest",
    "tsup": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
